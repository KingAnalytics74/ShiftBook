+.wico{flex:none;width:46px;height:46px;border-radius:14px;display:grid;place-items:center;background:var(--g-soft);color:var(--g-gold-deep);border:1px solid var(--g-line)}
+.wfeat b{display:block;font-size:16px;color:var(--g-ink)}
+.wfeat span span,.wfeat div>span{display:block;font-size:14px;color:var(--muted);line-height:1.35}
+.wact{display:flex;flex-direction:column;gap:12px;padding:6px 0 4px}
+@keyframes wrise{from{opacity:0;transform:translateY(14px)}}
+@keyframes wcardin{from{opacity:0;transform:translateY(28px) scale(.955)}}
+@keyframes wfill{from{transform:scaleX(0)}}
+
+/* time pickers: hour and minute in one pill */
+.tpick{display:flex;align-items:center;justify-content:center;gap:2px;height:56px;border-radius:14px;border:1.5px solid var(--g-line,var(--line));background:var(--surface);transition:border-color .15s ease-out,box-shadow .15s ease-out}
+.tpick:focus-within{border-color:var(--g-gold,var(--ink));box-shadow:0 0 0 4px rgba(227,169,24,.25)}
+.tpick select{appearance:none;-webkit-appearance:none;width:auto!important;min-width:52px;border:0!important;background:transparent!important;box-shadow:none!important;padding:8px 6px!important;text-align:center;text-align-last:center;font-family:var(--f-num);font-variant-numeric:tabular-nums;font-size:26px!important;font-weight:600;color:var(--ink);cursor:pointer;border-radius:10px!important}
+.tpick select:focus-visible{outline:2px solid var(--g-gold-deep,var(--focus));outline-offset:-2px}
+.tpick>span{font-family:var(--f-num);font-size:26px;font-weight:600;color:var(--g-gold-deep,var(--muted));padding-bottom:3px}
+html:has(body.authing),html:has(body.onboarding){--bg:#FFF8E6;background:#FFF8E6}
+
+/* ===== Motion system for the sign-up screens =====
+   Rules: only transform and opacity move. Springs (slight overshoot, like iOS) for things that travel,
+   ease-out for fades, 100ms for presses. With reduced motion on, everything below is switched off by the
+   global rule at the top, and every animated element rests in its finished state, so nothing is lost. */
+body.authing,body.onboarding{
+  --ease-out:cubic-bezier(.22,1,.36,1);
+  --press:cubic-bezier(.3,.7,.4,1);
+  --spring:cubic-bezier(.34,1.35,.64,1);
+  -webkit-tap-highlight-color:transparent}
+@supports (transition-timing-function:linear(0,1)){
+  body.authing,body.onboarding{--spring:linear(0,.047,.156,.293,.434,.565,.679,.774,.848,.905,.947,.975,.994,1.006,1.012,1.015,1.015,1.014,1.012,1.01,1.008,1.006,1.004,1.003,1.002,1.001,1.001,1,1,1,1)}
+}
+body.authing button,body.onboarding button,body.authing a,body.onboarding a{touch-action:manipulation}
+
+/* buttons: sink on press (fast), rise back on a spring */
+body.authing .btn,body.onboarding .btn{transition:transform .5s var(--spring),box-shadow .25s var(--ease-out),background-color .2s var(--ease-out);will-change:transform}
+body.authing .btn:active,body.onboarding .btn:active{transform:scale(.965);transition-duration:.09s,.09s,.2s;transition-timing-function:var(--press)}
+body.authing .btn.busy::before{content:"";display:inline-block;width:15px;height:15px;margin-right:10px;vertical-align:-2px;border:2px solid currentColor;border-right-color:transparent;border-radius:50%;animation:wspin .7s linear infinite}
+@keyframes wspin{to{transform:rotate(360deg)}}
+
+/* errors arrive, they don't pop */
+body.authing .banner.bad:not([hidden]),body.onboarding .banner.bad:not([hidden]){animation:wbanner .3s var(--ease-out) backwards}
+@keyframes wbanner{from{opacity:0;transform:translateY(-6px)}}
+
+/* the example card's gold sheen: one pass, after the number has landed */
+.wcard::before{content:"";position:absolute;top:-25%;bottom:-25%;left:-45%;width:38%;opacity:0;pointer-events:none;z-index:1;
+  background:linear-gradient(90deg,rgba(255,236,170,0),rgba(255,236,170,.3),rgba(255,236,170,0));transform:skewX(-18deg);
+  animation:wsheen 1.1s 1.3s var(--ease-out)}
+@keyframes wsheen{0%{opacity:0;transform:translateX(0) skewX(-18deg)}12%{opacity:1}88%{opacity:1}100%{opacity:0;transform:translateX(420%) skewX(-18deg)}}
+
+/* feature icons draw themselves in, row by row (pathLength is set to 1 in auth.js) */
+.wico svg *{stroke-dasharray:1;stroke-dashoffset:0;animation:wdraw .9s var(--ease-out) backwards}
+.wfeat li:nth-child(1) .wico svg *{animation-delay:.45s}.wfeat li:nth-child(2) .wico svg *{animation-delay:.53s}.wfeat li:nth-child(3) .wico svg *{animation-delay:.61s}
+@keyframes wdraw{from{stroke-dashoffset:1}}
+
+/* coming back to the welcome page: no replay of the intro */
+.welcome.again .wcard,.welcome.again .wcard::before,.welcome.again .wbar i,.welcome.again .wfeat li,.welcome.again .wico svg *{animation:none!important}
+
+/* setup: the progress bar and chosen options settle on a spring */
+body.onboarding .onbbar i{transition:width .6s var(--spring)}
+body.onboarding .obchips button[aria-pressed="true"],body.onboarding .obtypes button[aria-pressed="true"]{animation:wpop .45s var(--spring)}
+body.onboarding .obchips button,body.onboarding .obtypes button{transition:background-color .2s var(--ease-out),border-color .2s var(--ease-out),box-shadow .25s var(--ease-out),transform .45s var(--spring)}
+body.onboarding .obchips button:active,body.onboarding .obtypes button:active{transform:scale(.96);transition-duration:.09s}
+@keyframes wpop{from{transform:scale(.94)}}
+body.onboarding .tpick select{transition:background-color .15s var(--ease-out)}
+@media (hover:hover){body.onboarding .tpick select:hover{background:var(--g-soft)!important}}
+.strow .tpick{height:52px}
+.strow .tpick select{font-size:22px!important;min-width:44px}
+.strow .tpick>span{font-size:22px}
+
+/* reload: hide the app until sign-in / setup / app is decided, so the previous screen never flashes */
+html.boot .wrap{visibility:hidden}
+html.boot-light,html.boot-light body{background:#FFF8E6!important}
+html.boot-light body::before{background:#FFF8E6!important}
+html.booted .wrap{animation:bootin .22s var(--ease-out,ease-out) both}
+@keyframes bootin{from{opacity:0}to{opacity:1}}
